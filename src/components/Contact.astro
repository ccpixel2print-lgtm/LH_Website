---
---

<section id="contact" class="py-24 sm:py-32 bg-white">
  <div class="section-padding max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">

      <!-- Left: Info & Map -->
      <div class="reveal">
        <span class="inline-block text-sunset-500 text-sm font-sans font-semibold tracking-widest uppercase mb-4">Get In Touch</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 leading-tight text-balance">
          Start Your Journey <br class="hidden sm:block" />Today.
        </h2>
        <p class="mt-5 text-lg text-neutral-500 font-sans leading-relaxed text-pretty max-w-md">
          Book a site visit, ask questions, or simply learn more about Future Green City. Our team is ready to help you take the first step toward your family's weekend sanctuary.
        </p>

        <!-- Contact Details -->
        <div class="flex flex-col gap-6 mt-10">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-leaf-50 text-green-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-sans font-semibold text-neutral-900">Phone</p>
              <p class="text-sm text-neutral-500 font-sans mt-0.5">+91 90325 83636</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-leaf-50 text-green-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-sans font-semibold text-neutral-900">Email</p>
              <p class="text-sm text-neutral-500 font-sans mt-0.5">info@legendhomes.in</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-leaf-50 text-green-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-sans font-semibold text-neutral-900">Office</p>
              <p class="text-sm text-neutral-500 font-sans mt-0.5 leading-relaxed">
                Flat No: W102, SVSS NIVAS, Street No: 01,<br />
                Above Vijetha Supermarket, Czech Colony,<br />
                Sanath Nagar, Hyderabad – 18
              </p>
            </div>
          </div>
        </div>

        <!-- Exact Location Map -->
        <div class="mt-10 rounded-2xl overflow-hidden border border-neutral-200 bg-neutral-100 aspect-video shadow-sm">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3806.113528511179!2d78.43277927421111!3d17.454279500876556!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bcb9117be23afb7%3A0x36b97886e0b9f796!2sLegend%20Homes!5e0!3m2!1sen!2sin!4v1774713860859!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Legend Homes office location in Hyderabad"
            class="w-full h-full grayscale-[20%] contrast-[90%]"
          ></iframe>
        </div>
      </div>

      <!-- Right: Contact Form -->
      <div class="reveal" style="transition-delay: 0.15s;">
        <div class="bg-stone-50 rounded-2xl p-8 sm:p-10 border border-neutral-100 shadow-sm">
          <h3 class="font-serif text-2xl font-bold text-neutral-900 mb-2">Schedule a Site Visit</h3>
          <p class="text-neutral-500 font-sans text-sm mb-8">Fill in your details and we will reach out within 24 hours.</p>

          <form class="flex flex-col gap-5" action="#" method="POST">
            <!-- Name -->
            <div>
              <label for="name" class="block text-sm font-sans font-medium text-neutral-700 mb-2">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter your full name"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-white border border-neutral-200 text-neutral-900 font-sans text-sm placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sunset-500/30 focus:border-sunset-500 transition-all"
              />
            </div>

            <!-- Phone -->
            <div>
              <label for="phone" class="block text-sm font-sans font-medium text-neutral-700 mb-2">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+91 98765 43210"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-white border border-neutral-200 text-neutral-900 font-sans text-sm placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sunset-500/30 focus:border-sunset-500 transition-all"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-sans font-medium text-neutral-700 mb-2">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-white border border-neutral-200 text-neutral-900 font-sans text-sm placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sunset-500/30 focus:border-sunset-500 transition-all"
              />
            </div>

            <!-- Preferred Visit Date -->
            <div>
              <label for="visit-date" class="block text-sm font-sans font-medium text-neutral-700 mb-2">Preferred Visit Date</label>
              <input
                type="date"
                id="visit-date"
                name="visit-date"
                class="w-full px-4 py-3.5 rounded-xl bg-white border border-neutral-200 text-neutral-900 font-sans text-sm placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-sunset-500/30 focus:border-sunset-500 transition-all"
              />
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-sunset-500 hover:bg-sunset-600 text-white mt-2 py-4 rounded-xl text-base font-semibold flex items-center justify-center gap-2 transition-colors duration-300 shadow-md"
            >
              Request Site Visit
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </button>

            <p class="text-xs text-neutral-400 font-sans text-center mt-2">
              By submitting, you agree to our privacy policy. We respect your data.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
