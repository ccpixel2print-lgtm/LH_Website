---
import { Image } from 'astro:assets';

import imgClubHouse from '../assets/images/FGC_Ch.png';
import imgPool from '../assets/images/pool.png';
import imgSports from '../assets/images/amenities.png';
import imgKids from '../assets/images/childplay.png';
---
<section id="lifestyle" class="py-16 sm:py-24 bg-white">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center max-w-3xl mx-auto mb-14 lg:mb-20">
      <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Community Lifestyle</span>
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold font-serif text-[#1a1a1a] leading-tight mb-5">Live Your <span class="text-[#649b38]">Best Life</span></h2>
      <p class="text-[16px] text-[#666666] font-sans leading-relaxed">Experience a lifestyle where every day feels like a vacation, surrounded by premium amenities designed for your holistic well-being.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 auto-rows-[250px] lg:auto-rows-[280px]">
      
      <!-- Swimming Pool (Now spanning 2x2) -->
      <div class="reveal relative md:col-span-2 md:row-span-2 rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden group shadow-sm border border-[#f4f5f0]">
        <Image src={imgPool} alt="Resort Style Swimming Pool" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6 sm:p-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold uppercase tracking-[0.1em] mb-3">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" /></svg>
            The Heartbeat
          </div>
          <h3 class="text-2xl sm:text-[2rem] font-bold text-white font-serif mb-2 leading-tight">Resort-Style Pool</h3>
          <p class="text-white/80 text-sm sm:text-[15px] font-sans max-w-md">Dive into relaxation or enjoy weekend parties in our beautifully designed luxury swimming pool.</p>
        </div>
      </div>
      
      <!-- Club House (Now taking the single grid spot) -->
      <div class="reveal relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden group shadow-sm border border-[#f4f5f0]" style="transition-delay: 0.1s;">
        <Image src={imgClubHouse} alt="Premium Club House" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <h3 class="text-[1.25rem] font-bold text-white font-serif mb-1">Grand Club House</h3>
          <p class="text-white/80 text-[13px] font-sans leading-snug">A luxurious space for community gatherings and events.</p>
        </div>
      </div>
      
      <!-- Security -->
      <div class="reveal bg-[#fdfdfc] rounded-[1.5rem] sm:rounded-[2rem] p-6 border border-[#e8f0df] shadow-sm flex flex-col justify-center" style="transition-delay: 0.2s;">
        <div class="w-10 h-10 bg-[#f2f7ec] rounded-xl flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
        </div>
        <h3 class="text-[1.1rem] font-bold text-[#1a1a1a] font-serif mb-2">Ironclad Security</h3>
        <p class="text-[13px] text-[#666666] font-sans leading-relaxed">24/7 CCTV surveillance and a full compound wall for absolute peace of mind.</p>
      </div>
      
      <!-- Sports -->
      <div class="reveal relative rounded-[1.5rem] sm:rounded-[2rem] overflow-hidden group shadow-sm border border-[#f4f5f0]" style="transition-delay: 0.3s;">
        <Image src={imgSports} alt="Sports Courts" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" quality="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full p-6">
          <h3 class="text-[1.25rem] font-bold text-white font-serif mb-1">Sports Arena</h3>
          <p class="text-white/80 text-[13px] font-sans leading-snug">Box Cricket, Pickle Ball & Basketball Courts.</p>
        </div>
      </div>
      
      <!-- 18+ Amenities -->
      <div class="reveal bg-[#fffaf5] rounded-[1.5rem] sm:rounded-[2rem] p-6 sm:p-8 border border-[#f19014]/20 shadow-sm flex flex-col justify-center items-center text-center relative overflow-hidden" style="transition-delay: 0.4s;">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-[#f19014]/5 rounded-full blur-xl"></div>
        <div class="text-[3rem] font-bold text-[#f19014] font-serif leading-none mb-2">18+</div>
        <h3 class="text-[1.1rem] font-bold text-[#1a1a1a] font-sans mb-2">Premium Amenities</h3>
        <p class="text-[13px] text-[#666666] font-sans leading-relaxed">From open gyms and jogging tracks to landscaped meditation zones. Designed for true resort-level living.</p>
      </div>
      
    </div>
  </div>
</section>