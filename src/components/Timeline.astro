---
const milestones = [
  {
    title: 'Land Acquisition & Title Clearing',
    description: 'Complete land survey, legal verification, and clear title documentation finalized.',
    status: 'completed' as const,
  },
  {
    title: 'DTCP & RERA Approvals',
    description: 'Full regulatory compliance, DTCP approval, and RERA registration successfully obtained.',
    status: 'completed' as const,
  },
  {
    title: 'Phase-I Layout & Infrastructure',
    description: 'Road networks, drainage, landscaping, and essential amenities under active development.',
    status: 'in-progress' as const,
  },
  {
    title: 'Plot Handover',
    description: 'Final survey, boundary marking, and registered handover to plot owners.',
    status: 'in-progress' as const,
  },
  {
    title: 'Phase-II Commencement',
    description: 'Initiation of Phase-II plotting, premium amenities expansion, and extended landscaping.',
    status: 'upcoming' as const,
  }
];
---

<section class="py-24 sm:py-32 bg-alabaster">
  <div class="section-padding max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="reveal max-w-3xl mx-auto text-center mb-20">
      <span class="inline-block text-leaf-500 text-sm font-sans font-semibold tracking-widest uppercase mb-4">Transparency</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 leading-tight text-balance">
        Development Progress
      </h2>
      <p class="mt-5 text-lg text-neutral-500 font-sans leading-relaxed text-pretty max-w-xl mx-auto">
        We believe in radical transparency. Track every milestone of Future Green City's development right here.
      </p>
    </div>

    <!-- Timeline -->
    <div class="max-w-3xl mx-auto">
      {milestones.map((milestone, index) => (
        <div class="reveal flex gap-6 sm:gap-8" style={`transition-delay: ${index * 0.1}s;`}>
          <!-- Timeline Line & Dot -->
          <div class="flex flex-col items-center">
            {/* Dot */}
            <div class:list={[
              'relative flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center border-2',
              milestone.status === 'completed' && 'bg-leaf-500 border-leaf-500 text-white',
              milestone.status === 'in-progress' && 'bg-sunset-500 border-sunset-500 text-white animate-pulse-slow',
              milestone.status === 'upcoming' && 'bg-white border-neutral-300 text-neutral-400',
            ]}>
              {milestone.status === 'completed' && (
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              )}
              {milestone.status === 'in-progress' && (
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1-3.26m0 0l3.26-5.1m-3.26 5.1H21" />
                </svg>
              )}
              {milestone.status === 'upcoming' && (
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
            </div>
            {/* Line */}
            {index < milestones.length - 1 && (
              <div class:list={[
                'w-0.5 flex-1 min-h-[60px]',
                milestone.status === 'completed' ? 'bg-leaf-300' : 'bg-neutral-200',
              ]} />
            )}
          </div>

          <!-- Content -->
          <div class="pb-12 sm:pb-16 pt-1">
            <div class="flex items-center gap-3 mb-2">
              <h3 class:list={[
                'font-serif text-lg sm:text-xl font-bold',
                milestone.status === 'upcoming' ? 'text-neutral-400' : 'text-neutral-900',
              ]}>
                {milestone.title}
              </h3>
              {milestone.status === 'completed' && (
                <span class="px-2.5 py-0.5 rounded-full bg-leaf-50 text-leaf-600 text-xs font-sans font-semibold tracking-wide">Completed</span>
              )}
              {milestone.status === 'in-progress' && (
                <span class="px-2.5 py-0.5 rounded-full bg-sunset-50 text-sunset-600 text-xs font-sans font-semibold tracking-wide">In Progress</span>
              )}
              {milestone.status === 'upcoming' && (
                <span class="px-2.5 py-0.5 rounded-full bg-neutral-100 text-neutral-400 text-xs font-sans font-semibold tracking-wide">Upcoming</span>
              )}
            </div>
            <p class:list={[
              'font-sans text-sm leading-relaxed text-pretty max-w-md',
              milestone.status === 'upcoming' ? 'text-neutral-400' : 'text-neutral-500',
            ]}>
              {milestone.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
