---
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-white">
  <!-- Main Footer -->
  <div class="section-padding max-w-7xl mx-auto py-16 sm:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="#" class="inline-flex items-center gap-3">
          <img src="/images/logo.png" alt="Legend Homes" class="h-14 w-auto brightness-0 invert opacity-90" />
        </a>
        <p class="mt-5 text-neutral-400 font-sans text-sm leading-relaxed max-w-xs text-pretty">
          A symbol of authenticity. Building trust, one family at a time, with premium holiday home plots in Jangaon Dist.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-sans text-sm font-semibold text-white tracking-wider uppercase mb-5">Quick Links</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="#philosophy" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">Our Philosophy</a></li>
          <li><a href="#vision" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">The Vision</a></li>
          <li><a href="#flagship" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">Future Green City</a></li>
          <li><a href="#contact" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-sans text-sm font-semibold text-white tracking-wider uppercase mb-5">Legal</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="#" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="#" class="text-neutral-400 font-sans text-sm hover:text-white transition-colors">RERA Information</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-sans text-sm font-semibold text-white tracking-wider uppercase mb-5">Reach Us</h4>
        <ul class="flex flex-col gap-3">
          <li class="flex items-center gap-2 text-neutral-400 font-sans text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            +91 90325 83636
          </li>
          <li class="flex items-center gap-2 text-neutral-400 font-sans text-sm">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            info@legendhomes.in
          </li>
          <li class="flex items-start gap-2 text-neutral-400 font-sans text-sm">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            Hyderabad, Telangana, India
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-neutral-800">
    <div class="section-padding max-w-7xl mx-auto py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-neutral-500 font-sans text-xs text-center sm:text-left">
        &copy; {currentYear} Legend Homes. All rights reserved.
      </p>
      <p class="text-neutral-600 font-sans text-[10px] text-center sm:text-right max-w-lg leading-relaxed">
        Disclaimer: RERA registration details are available upon request. All project visuals and descriptions are indicative and subject to regulatory approvals. Please verify all details independently before making any investment decisions.
      </p>
    </div>
  </div>
</footer>
