---
const features = [
  {
    title: "100% Clear Titles",
    description: "Own your plot with fully verified, dispute-free documentation.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`
  },
  {
    title: "Middle-Class Accessible",
    description: "Own your dream plot with budget-friendly pricing and flexible plans.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />`
  },
  {
    title: "Uncompromising Quality",
    description: "From infrastructure to green spaces, every detail is crafted to exceed expectations. Quality you can see and feel.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />` // Using a structure/quality icon as a fallback, Astro will render the exact SVG path here.
  },
  {
    title: "Smart Investment Opportunities",
    description: "With strategic locations, rapid development plans, and market-aligned pricing, Legend Homes provides investors a chance to grow their wealth.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
  }
];

// Leaf Icon specifically for the third card to match the design exactly
const leafIconPath = `<path stroke-linecap="round" stroke-linejoin="round" d="M11.412 15.655L9.75 21m2.435-8.153a5.25 5.25 0 00-7.142-7.142c-1.378 1.378-2.126 3.42-2.052 5.565a5.25 5.25 0 005.564 5.565c2.146.074 4.188-.674 5.566-2.052z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75l-4.5 4.5" />`;
features[2].icon = leafIconPath;
---

<section id="why-choose-us" class="py-24 bg-white">
  <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-sunset-500 text-xs font-bold tracking-[0.15em] uppercase mb-4">
        Why Choose Legend Homes
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold font-serif text-neutral-900 leading-tight mb-5">
        Peaceful Living <span class="text-leaf-500">In Natural Surroundings</span>
      </h2>
      <p class="text-[17px] text-[#666666] font-sans leading-relaxed">
        Experience a lifestyle where modern living blends seamlessly with natural surroundings.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div 
          class="reveal flex flex-col items-center text-center p-8 sm:p-10 rounded-[1.5rem] transition-all duration-300 hover:-translate-y-1 hover:shadow-lg border border-[#f4f5f0]"
          style={`background: linear-gradient(to bottom, #fcfcfb, #ffffff); transition-delay: ${index * 0.1}s; box-shadow: 0 4px 20px -2px rgba(0,0,0,0.03);`}
        >
          <!-- Icon Container -->
          <div class="w-[60px] h-[60px] rounded-full bg-[#f2f7ec] flex items-center justify-center mb-8 border border-[#e8f0df]">
            <svg 
              class="w-7 h-7 text-leaf-500" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke="currentColor" 
              stroke-width="1.5"
              set:html={feature.icon}
            />
          </div>

          <!-- Text Content -->
          <h3 class="text-xl font-bold text-neutral-800 mb-4 font-sans">
            {feature.title}
          </h3>
          <p class="text-[14px] text-[#737373] leading-[1.7] font-sans">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
