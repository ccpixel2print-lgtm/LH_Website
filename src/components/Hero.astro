---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src="/images/hero-bg.jpg"
      alt="Lush green landscape in Hyderabad countryside"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <!-- Dark gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 section-padding w-full max-w-7xl mx-auto pt-28 pb-20">
    <div class="max-w-3xl">
      <!-- Tagline Badge -->
      <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/15 mb-8">
        <span class="w-2 h-2 rounded-full bg-leaf-500"></span>
        <span class="text-sm font-sans font-medium text-white/80 tracking-wide">A Symbol of Authenticity</span>
      </div>

      <!-- Headline -->
      <h1 class="reveal font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] tracking-tight text-balance" style="transition-delay: 0.1s;">
        Your Family's Weekend <br class="hidden sm:block" />
        <span class="text-sunset-400">Sanctuary</span> Awaits.
      </h1>

      <!-- Sub-headline -->
      <p class="reveal mt-6 sm:mt-8 text-lg sm:text-xl text-white/75 font-sans leading-relaxed max-w-xl text-pretty" style="transition-delay: 0.2s;">
        Escape the city. Secure your future with a premium holiday home plot in Hyderabad's most trusted green corridor.
      </p>

      <!-- CTAs -->
      <div class="reveal flex flex-col sm:flex-row gap-4 mt-10" style="transition-delay: 0.35s;">
        <a href="#flagship" class="btn-primary text-base px-9 py-4">
          Discover Future Green City
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#philosophy" class="btn-outline text-base px-9 py-4">
          Read Our Mission
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-60">
    <span class="text-white/60 text-xs font-sans tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
  </div>
</section>
