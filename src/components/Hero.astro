---
// Import Astro's built-in image optimizer
import { Image } from 'astro:assets';

// Import your actual local image files
import mainHeroImage from '../assets/images/LH_Img3.png';
import overlayClubHouseImage from '../assets/images/FGC_Ch.png';
---

<section id="home" class="relative pt-24 pb-16 lg:pt-32 lg:pb-24 overflow-hidden bg-stone-50">
  <!-- Changed grid layout: text gets less space, image gets more space -->
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[45fr_55fr] gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Content -->
      <div class="reveal max-w-xl xl:pr-8">
        
        <!-- Headline -->
        <h1 class="text-[3.5rem] sm:text-6xl lg:text-[4.5rem] font-bold font-serif text-neutral-900 leading-[1.05] tracking-tight mb-6">
          Building <br />
          <span class="text-[#2eb85c]">Communities</span> <br />
          Close to <span class="text-[#f97316]">Nature</span>
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg text-neutral-600 font-sans mb-10 leading-relaxed text-pretty">
          Escape the city hustle and discover a resort-style sanctuary, perfectly positioned near the future Mamnoor Airport.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-14">
          <a href="#flagship" class="bg-[#2eb85c] hover:bg-green-600 text-white px-8 py-3.5 rounded-full font-semibold transition-all duration-300 flex items-center gap-2 shadow-lg shadow-green-500/20">
            View Projects
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#contact" class="bg-transparent border-2 border-[#f97316] text-[#f97316] hover:bg-orange-50 px-8 py-3.5 rounded-full font-semibold transition-all duration-300">
            Book Site Visit
          </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-3 gap-4 pt-8 border-t border-gray-200">
          <div>
            <div class="text-3xl sm:text-4xl font-bold text-[#2eb85c] mb-1">100+</div>
            <div class="text-xs sm:text-sm font-medium text-neutral-500 font-sans">Acres Land<br/>Developed</div>
          </div>
          <div class="border-l border-gray-200 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl font-bold text-[#f97316] mb-1">25+</div>
            <div class="text-xs sm:text-sm font-medium text-neutral-500 font-sans">Years of<br/>Experience</div>
          </div>
          <div class="border-l border-gray-200 pl-4 sm:pl-6">
            <div class="text-3xl sm:text-4xl font-bold text-[#2eb85c] mb-1">15+</div>
            <div class="text-xs sm:text-sm font-medium text-neutral-500 font-sans">Projects<br/>Delivered</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Picture-in-Picture Images -->
      <div class="reveal relative lg:pl-4 pb-16 lg:pb-24 mt-6 lg:mt-0">
        
        <!-- Main Large Image -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-xl aspect-[16/10] w-full bg-neutral-200">
          <Image 
            src={mainHeroImage} 
            alt="Premium Villas at Legend Homes" 
            class="w-full h-full object-cover"
            quality="high"
            loading="eager"
          />
        </div>

        <!-- Overlapping Smaller Image (FGC Club House) -->
        <div class="absolute -bottom-6 sm:-bottom-12 left-0 sm:-left-12 w-[85%] sm:w-[70%] lg:w-[65%] rounded-2xl shadow-2xl shadow-black/20 overflow-hidden border border-white/20">
          <div class="relative aspect-[21/9] w-full bg-neutral-100">
            <Image 
              src={overlayClubHouseImage} 
              alt="Future Green City Club House" 
              class="w-full h-full object-cover"
              quality="high"
            />
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
