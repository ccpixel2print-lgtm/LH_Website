---
import { Image } from 'astro:assets';

import imgYadadri from '../assets/images/yadadri-temples.png';
import imgSwarnaGiri from '../assets/images/swarna-giri.png';
import imgAirport from '../assets/images/mamnoor-airport.png';
import imgAiims from '../assets/images/aiims.png';

const highlights = [
  { text: "10 Min. Drive from Janagaon Collector Office", icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" },
  { text: "15 Min. Drive from Janagaon Bus Stand & Railway Station", icon: "M4 6h16M4 10h16M4 14h16M4 18h16" }, 
  { text: "60 Min. Drive from Outer Ring Road", icon: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" },
  { text: "Close to Sri Ramachandra Swamy Devasthanam, Jeedikal", icon: "M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16M9 21v-4a2 2 0 012-2h2a2 2 0 012 2v4" }, 
  { text: "Close to Swarna Giri Temple", icon: "M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16M9 21v-4a2 2 0 012-2h2a2 2 0 012 2v4" },
  { text: "Near to Kakam Textile Park", icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21" }, 
  { text: "Close to Yadadri Sri Lakshmi Narasimha Swamy Devasthanam", icon: "M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16M9 21v-4a2 2 0 012-2h2a2 2 0 012 2v4" },
  { text: "Close to AIIMS Hospital", icon: "M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z M12 8v5m-2.5-2.5h5" }, 
  { text: "Close to Mamnoor Airport", icon: "M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" }, 
];

const locations = [
  { title: "Yadadri Temples", image: imgYadadri },
  { title: "Swarna Giri Temple", image: imgSwarnaGiri },
  { title: "Mamnoor Airport", image: imgAirport },
  { title: "AIIMS Hospital", image: imgAiims }
];
---

<section id="location" class="py-16 sm:py-24 bg-[#fdfdfc]">
  <!-- Fixed: Changed max-w-[85rem] to match the Hero and Flagship exactly -->
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">
        Strategic Location
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold font-serif text-[#1a1a1a] leading-tight mb-5">
        Connected to <span class="text-[#649b38]">Everything</span>
      </h2>
      <p class="text-[16px] text-[#666666] font-sans leading-relaxed">
        Prime locations with excellent connectivity to major IT hubs, educational institutions, healthcare, and entertainment.
      </p>
    </div>

    <!-- Main Content Grid -->
    <!-- Adjusted grid gap to push content closer to the left edge -->
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-10 lg:gap-16 items-start xl:pr-8">
      
      <!-- Left Column: Highlights List -->
      <div class="reveal">
        <!-- Title Box: Using the exact square rounded corner style from your image -->
        <div class="flex items-center gap-4 mb-8">
          <div class="w-12 h-12 rounded-xl bg-[#649b38] flex items-center justify-center shadow-md">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
          </div>
          <h3 class="text-[1.75rem] font-serif font-bold text-[#1a1a1a]">Location Highlights</h3>
        </div>

        <!-- List Items -->
        <div class="flex flex-col gap-6 pl-1">
          {highlights.map((item) => (
            <div class="flex items-center gap-5 group">
              <!-- Icon Box: Changed to match your screenshot (soft green square) -->
              <div class="w-10 h-10 rounded-lg bg-[#f2f7ec] flex items-center justify-center flex-shrink-0 transition-colors duration-300 group-hover:bg-[#e5f0dc]">
                <svg class="w-4 h-4 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <!-- Text -->
              <span class="text-[15px] font-sans text-[#4a4a4a] group-hover:text-[#1a1a1a] transition-colors">
                {item.text}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Image Grid -->
      <div class="reveal grid grid-cols-2 gap-4 sm:gap-6 mt-10 lg:mt-0" style="transition-delay: 0.2s;">
        {locations.map((loc) => (
          <div class="bg-white rounded-[1.25rem] shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] border border-[#f4f5f0] overflow-hidden flex flex-col transition-transform hover:-translate-y-1 duration-300">
            <!-- Image Area -->
            <div class="relative w-full aspect-[4/3] bg-neutral-100">
              <Image 
                src={loc.image} 
                alt={loc.title} 
                class="w-full h-full object-cover"
                quality="high"
              />
            </div>
            <!-- Title Area -->
            <div class="py-4 px-3 text-center bg-white flex-grow flex items-center justify-center">
              <h4 class="text-[14px] font-sans font-bold text-[#1a1a1a]">
                {loc.title}
              </h4>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
