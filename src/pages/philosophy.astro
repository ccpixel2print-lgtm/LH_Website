---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Philosophy | Legend Homes">
  <Navigation />
  
  <main class="pt-20">
    <!-- Sub-page Hero Section -->
    <section class="relative py-20 lg:py-28 bg-[#fdfdfc] border-b border-gray-100">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Core Values</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-serif text-neutral-900 mb-6">
          Our <span class="text-[#649b38]">Philosophy</span>
        </h1>
        <p class="text-lg text-neutral-600 font-sans max-w-2xl mx-auto leading-relaxed">
          Driven by a value-based and trust-based approach, we prioritize high-quality materials, clear titles, and long-term relationships with our clients.
        </p>
      </div>
    </section>

    <!-- Placeholder for Philosophy Details -->
    <section class="py-24 bg-white">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 text-center">
         <h2 class="text-2xl font-serif text-neutral-800 mb-4">Why We Do What We Do</h2>
         <p class="text-neutral-500 italic">We will design the detailed mission, vision, and deep-dive into the trust-based approach here.</p>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>