---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

import { Image } from 'astro:assets';

import cam from '../assets/images/Image4.JPG';
import fgc from '../assets/images/Image24.JPG';
import lay1 from '../assets/images/Image27.jpeg';
import lay2 from '../assets/images/LH_Img1.png';
import lay3 from '../assets/images/LH_Img2.png';
import lay4 from '../assets/images/LH_Img3.png';
import clubh from '../assets/images/FGC_Ch.png';
import pool from '../assets/images/pool.png';
---

<Layout title="Fortune Green City | Legend Homes">
  <Navigation />
  
  <main class="pt-20">
    <!-- Sub-page Hero Section -->
    <section class="relative py-20 lg:py-32 bg-[#fdfdfc] overflow-hidden">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-stone-100 rounded-bl-[100px] -z-10 opacity-50"></div>
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="reveal">
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-50 border border-green-100 text-[#649b38] text-xs font-bold tracking-[0.15em] uppercase mb-6">
              DTCP & RERA Approved
            </span>
            <h1 class="text-4xl sm:text-5xl lg:text-[4rem] font-bold font-serif text-neutral-900 mb-6 leading-[1.1]">
              Fortune <span class="text-[#649b38]">Green City</span>
            </h1>
            <p class="text-lg text-neutral-600 font-sans leading-relaxed mb-8 pr-4">
              A visionary lifestyle destination thoughtfully designed to blend eco-conscious living with modern luxury. Discover a master-planned community offering sustainable features and world-class resort amenities.
            </p>
            <a href="/#contact" class="inline-flex items-center gap-2 bg-[#f19014] hover:bg-orange-600 text-white px-8 py-3.5 rounded-full font-semibold transition-all duration-300 shadow-lg shadow-orange-500/20">
              Enquire Pricing & Offers
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
          <div class="reveal relative rounded-[2rem] overflow-hidden shadow-2xl aspect-[4/3] group">
            <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=2070&auto=format&fit=crop" alt="Fortune Green City Overview" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6">
              <p class="text-white font-serif text-xl font-medium">Phase-I Currently Underway</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Stats Bar -->
    <section class="border-y border-gray-200 bg-white">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-gray-100">
          <div class="reveal">
            <div class="text-3xl lg:text-4xl font-bold text-[#649b38] mb-2 font-serif">17+</div>
            <div class="text-sm font-semibold text-neutral-500 uppercase tracking-wide">Premium Amenities</div>
          </div>
          <div class="reveal delay-100">
            <div class="text-3xl lg:text-4xl font-bold text-[#f19014] mb-2 font-serif">60%</div>
            <div class="text-sm font-semibold text-neutral-500 uppercase tracking-wide">Lush Green Area</div>
          </div>
          <div class="reveal delay-200">
            <div class="text-3xl lg:text-4xl font-bold text-[#649b38] mb-2 font-serif">1,200+</div>
            <div class="text-sm font-semibold text-neutral-500 uppercase tracking-wide">Plots Planned</div>
          </div>
          <div class="reveal delay-300">
            <div class="text-3xl lg:text-4xl font-bold text-[#f19014] mb-2 font-serif">100%</div>
            <div class="text-sm font-semibold text-neutral-500 uppercase tracking-wide">Clear Titles</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Smart Investment Opportunities -->
    <section class="py-16 sm:py-24 bg-stone-50">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center max-w-3xl mx-auto mb-16">
          <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Affordable Pricing</span>
          <h2 class="text-3xl sm:text-4xl font-bold font-serif text-neutral-900 mb-4">Smart Investment Opportunities</h2>
          <p class="text-neutral-600 font-sans">We believe premium living should be accessible. Explore our flexible, stress-free payment models designed for your comfort.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- ₹1 Down Payment -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-[#f19014]/20 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-[#f19014]/10 rounded-bl-[100%] transition-transform group-hover:scale-110"></div>
            <div class="text-4xl font-bold text-[#f19014] font-serif mb-4">₹1</div>
            <h3 class="text-lg font-bold text-neutral-900 mb-2">Down Payment Model</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">Just pay ₹1 to block your plot. An exclusive offer that has attracted huge customer response.</p>
          </div>

          <!-- Easy EMI -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-gray-100 delay-100">
            <div class="w-12 h-12 bg-stone-100 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 mb-2">Easy & Flexible EMIs</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">No heavy down payments. No pressure. Choose an EMI plan that perfectly fits your financial comfort.</p>
          </div>

          <!-- High Appreciation -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-gray-100 delay-200">
            <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 mb-2">High Appreciation</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">With rapid infrastructure development in surrounding districts, land value here is increasing steadily.</p>
          </div>

          <!-- Safe Investment -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-gray-100 delay-300">
            <div class="w-12 h-12 bg-stone-100 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-neutral-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-neutral-900 mb-2">100% Safe Investment</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">DTCP & RERA Approved Layout ensures a completely safe, transparent, and worry-free investment.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- World-Class Resort Amenities -->
    <section class="py-16 sm:py-24 bg-white">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="reveal order-2 lg:order-1">
            <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Master-Planned Community</span>
            <h2 class="text-3xl sm:text-4xl font-bold font-serif text-neutral-900 mb-6">World-Class Resort Amenities</h2>
            <p class="text-neutral-600 font-sans mb-8 leading-relaxed">Properties with lifestyle amenities always grow faster in appreciation. At Fortune Green City, every amenity is crafted to deliver resort-style elegance, everyday comfort, and long-term lifestyle value.</p>
            
            <ul class="space-y-6">
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-50 flex items-center justify-center mt-1">
                  <span class="text-[#649b38] font-bold">01</span>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-neutral-900 mb-1">Exclusive 15,000 sq. ft. Clubhouse</h4>
                  <p class="text-sm text-neutral-600">Featuring a luxury swimming pool, refined indoor recreation, an amphitheater, and an elegant rooftop garden restaurant.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-50 flex items-center justify-center mt-1">
                  <span class="text-[#649b38] font-bold">02</span>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-neutral-900 mb-1">Signature Sports & Wellness</h4>
                  <p class="text-sm text-neutral-600">Curated outdoor sports courts, open-air fitness zones, dedicated kids play areas, and beautifully landscaped parks.</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-green-50 flex items-center justify-center mt-1">
                  <span class="text-[#649b38] font-bold">03</span>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-neutral-900 mb-1">Intelligent Infrastructure</h4>
                  <p class="text-sm text-neutral-600">33ft & 40ft CC Roads, underground drainage with STP, HDPE underground water supply, and overhead power supply.</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="reveal order-1 lg:order-2 relative">
            <div class="grid grid-cols-2 gap-4">
              <!-- FIXED: Replaced the broken Unsplash URL with a working resort pool image -->
              <!-- <img src="https://images.unsplash.com/photo-1582610116397-edb318620f90?q=80&w=1000&auto=format&fit=crop" alt="Clubhouse" class="rounded-[1.5rem] w-full h-64 object-cover shadow-lg" /> -->
              <!-- <img src="https://images.unsplash.com/photo-1519331379826-f10be5486c6f?q=80&w=1000&auto=format&fit=crop" alt="Parks" class="rounded-[1.5rem] w-full h-64 object-cover shadow-lg mt-8" /> -->
              <Image src={fgc} alt="Roads" class="rounded-[1.5rem] w-full h-64 object-cover shadow-lg" />
              <Image src={cam} alt="CC Cams" class="rounded-[1.5rem] w-full h-64 object-cover shadow-lg mt-8" />
            </div>
            <!-- Decorative badge -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white/90 backdrop-blur-md p-6 rounded-full shadow-2xl border border-white">
              <div class="text-center">
                <div class="text-2xl font-bold text-[#649b38]">24/7</div>
                <div class="text-xs font-bold text-neutral-600 uppercase tracking-wider">Security</div>
              </div>
            </div>
          </div>
        </div>

        <!-- NEW: Amenities Dropdown (Accordion) -->
        <div class="reveal mt-12">
          <details class="group bg-white rounded-[1.5rem] shadow-sm border border-gray-200 overflow-hidden cursor-pointer transition-all">
            <summary class="flex justify-between items-center font-medium list-none p-6 sm:px-8 text-lg sm:text-xl font-serif text-neutral-900 hover:text-[#649b38] transition-colors focus:outline-none">
              <span>View All 17+ Premium Amenities & Features</span>
              <span class="transition-transform duration-300 group-open:rotate-180 text-neutral-400 group-hover:text-[#649b38]">
                <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <div class="px-6 sm:px-8 pb-8 text-neutral-600 font-sans border-t border-gray-100">
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-y-4 gap-x-8 pt-6">
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 15,000 sq.ft. Grand Clubhouse</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Luxury Swimming Pool</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Open-Air Amphitheater</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Box Cricket & Sports Courts</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Dedicated Kids Play Zones</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Fully Equipped Open Gym</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Landscaped Parks & Gardens</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 33ft & 40ft CC Roads</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Underground Drainage & STP</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Overhead Power Supply</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> HDPE Water Supply System</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 24/7 Solar CCTV Surveillance</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> All-around Compound Wall</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Grand Entrance Gateway</div>
                <div class="flex items-center gap-3"><svg class="w-5 h-5 text-[#649b38]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 100% Clear Title Documentation</div>
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- NEW: Picture Gallery -->
    <section class="py-16 sm:py-24 bg-stone-50 border-t border-gray-200">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center max-w-3xl mx-auto mb-12">
          <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Gallery</span>
          <h2 class="text-3xl sm:text-4xl font-bold font-serif text-neutral-900 mb-4">Glimpses of Fortune Green City</h2>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          <div class="reveal rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm">
            <!-- <img src="https://images.unsplash.com/photo-1590625441584-638062ec7e51?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Venture Entrance" /> -->
            <Image src={lay1} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Venture Entrance" />
          </div>
          <div class="reveal delay-100 rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm md:col-span-2">
            <!-- <img src="https://images.unsplash.com/photo-1448630360428-65456885c650?q=80&w=1200&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="CC Roads & Layout" /> -->
            <Image src={pool} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="CC Roads & Layout" />
          </div>
          <div class="reveal delay-200 rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm">
            <!-- <img src="https://images.unsplash.com/photo-1605810230434-7631ac76ec81?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Green Parks" /> -->
            <Image src={lay3} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Green Parks" />
          </div>
          <div class="reveal rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm">
            <img src="https://images.unsplash.com/photo-1582610116397-edb318620f90?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Clubhouse Pool" />
          </div>
          <div class="reveal delay-100 rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm">
            <!-- <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=800&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Kids Play Area" /> -->
            <Image src={lay4} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Kids Play Area" />
          </div>
          <div class="reveal delay-200 rounded-[1.5rem] overflow-hidden aspect-square group shadow-sm md:col-span-2">
            <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?q=80&w=1200&auto=format&fit=crop" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="Premium Plots" />
          </div>
        </div>
      </div>
    </section>

    <!-- Seamless Connectivity & Location -->
    <section class="py-16 sm:py-24 bg-[#fdfdfc] border-t border-gray-200">
      <div class="max-w-[85rem] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="reveal text-center max-w-3xl mx-auto mb-16">
          <span class="inline-block text-[#f19014] text-xs font-bold tracking-[0.15em] uppercase mb-4">Prime Location</span>
          <h2 class="text-3xl sm:text-4xl font-bold font-serif text-neutral-900 mb-4">Seamless Connectivity</h2>
          <p class="text-neutral-600 font-sans">Strategically located near major transit hubs, spiritual landmarks, and upcoming infrastructure projects.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Transit -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-gray-100">
            <h3 class="text-xl font-bold font-serif text-neutral-900 mb-6 border-b border-gray-100 pb-4">Transit & Access</h3>
            <ul class="space-y-4">
              <li class="flex justify-between items-center text-sm">
                <span class="text-neutral-600">Jangaon Collector Office</span>
                <span class="font-bold text-[#f19014]">10 Mins</span>
              </li>
              <li class="flex justify-between items-center text-sm">
                <span class="text-neutral-600">Bus Stand & Railway Station</span>
                <span class="font-bold text-[#f19014]">15 Mins</span>
              </li>
              <li class="flex justify-between items-center text-sm">
                <span class="text-neutral-600">Outer Ring Road (ORR)</span>
                <span class="font-bold text-[#f19014]">60 Mins</span>
              </li>
            </ul>
          </div>

          <!-- Spiritual -->
          <div class="reveal bg-white p-8 rounded-[1.5rem] shadow-sm border border-gray-100 delay-100">
            <h3 class="text-xl font-bold font-serif text-neutral-900 mb-6 border-b border-gray-100 pb-4">Spiritual Landmarks</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-2 text-sm text-neutral-600">
                <svg class="w-5 h-5 text-[#649b38] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Sri Ramachandra Swamy Devasthanam, Jeedikal
